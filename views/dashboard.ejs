<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Dashboard</title>
    <style>
        body { font-family: Arial, sans-serif; background-color: #f0f2f5; padding: 50px; text-align: center; }
        .card { background: white; padding: 40px; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); display: inline-block; }
        a { text-decoration: none; color: #007bff; }
    </style>
</head>
<body>
    <div class="card">
        <h1>Welcome, <%= username %>!</h1>
        <p>You have successfully logged into the MVC application.</p>
        <br>
        <a href="/">← Logout</a>
    </div>
</body>
</html>
